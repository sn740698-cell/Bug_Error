# Django Settings
SECRET_KEY=django-insecure-master-rag-backend-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*
DATABASE_URL=sqlite:///db.sqlite3

# Vector Store Settings
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=user_knowledge_base

# Embedding Provider Configuration (options: mock, openai, huggingface, ollama)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=

# Multi-LLM Orchestration Settings
# Providers available: mock, openai, anthropic, ollama
LLM_A_PROVIDER=mock
LLM_A_MODEL=gpt-4o

LLM_B_PROVIDER=mock
LLM_B_MODEL=claude-3-5-sonnet

EVALUATOR_PROVIDER=mock
EVALUATOR_MODEL=gpt-4o

# Ollama local parameters (if provider is ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLAMA_MODEL=hf.co/hugging-quants/Llama-3.2-1B-Instruct-Q8_0-GGUF:Q8_0
OLLAMA_QWEN_MODEL=hf.co/nulledinstance/Qwen2.5-1B-Instruct-Q8_0-GGUF:Q8_0

# Agent Evaluation Feedback Loop Limit
MAX_RETRIES=2

# CORS & Upload Limits
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=25

# RAG Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.70
