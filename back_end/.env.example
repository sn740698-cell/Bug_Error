# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLAMA_MODEL=hf.co/hugging-quants/Llama-3.2-1B-Instruct-Q8_0-GGUF:Q8_0
OLLAMA_QWEN_MODEL=hf.co/nulledinstance/Qwen2.5-1B-Instruct-Q8_0-GGUF:Q8_0
DEFAULT_LLM=qwen

# Vector Store & AI Paths
DATA_DIR=D:/AIPlatform
CHROMA_PERSIST_DIR=data/chroma
HF_HOME=data/models/huggingface

# RAG & Semantic Filtering Config
TOP_K=5
SIMILARITY_THRESHOLD=0.70

# Retry & Iteration Safeguards
MAX_WORKFLOW_ITERATIONS=10
MAX_DRAFT_RETRIES=2
MAX_RETRIEVAL_RETRIES=2

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
